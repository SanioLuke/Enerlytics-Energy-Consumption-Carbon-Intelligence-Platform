# Auto-detect text files and normalize line endings on checkout.
* text=auto

# Shell scripts and Maven wrapper must use LF even on Windows,
# because they run inside Linux containers.
*.sh text eol=lf
*.bash text eol=lf
mvnw text eol=lf

# Windows batch files can keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jar binary
*.woff binary
*.woff2 binary
