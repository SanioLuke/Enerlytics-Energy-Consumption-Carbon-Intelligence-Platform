# Enerlytics local development environment
# Copy this file to .env and update values as needed.
# DO NOT commit real secrets or production credentials.

COMPOSE_PROJECT_NAME=enerlytics

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_APPLICATION_NAME=enerlytics-backend
FLYWAY_ENABLED=true

# JWT signing secrets (generate strong random values for any non-local use)
JWT_ACCESS_SECRET=change-me-in-production-access-secret-key-min-256-bits
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-key-min-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Development-only seed admin (leave blank to skip seeding)
DEV_ADMIN_EMAIL=admin@enerlytics.local
DEV_ADMIN_PASSWORD=changeme
DEV_ADMIN_DISPLAY_NAME=Development Admin
DEV_ADMIN_ORG_KEY=dev-organization
DEV_ADMIN_ORG_NAME=Development Organization

# Internal service-to-service API key (used by telemetry simulator registry endpoint)
INTERNAL_API_KEY=change-me-internal-api-key-min-32-characters-long

CORS_ALLOWED_ORIGINS=http://localhost:4200

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/enerlytics
POSTGRES_DB=enerlytics
POSTGRES_USER=enerlytics
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_ID=1
KAFKA_PORT=9092

# -----------------------------------------------------------------------------
# Telemetry Ingestion
# -----------------------------------------------------------------------------
METER_READING_VALIDATED_TOPIC=enerlytics.telemetry.meter-reading-validated.v1
METER_READING_REJECTED_TOPIC=enerlytics.telemetry.meter-reading-rejected.v1
KAFKA_INGESTION_GROUP_ID=enerlytics-telemetry-ingestion
KAFKA_AGGREGATION_GROUP_ID=enerlytics-energy-aggregation
OUTBOX_RELAY_INTERVAL=PT1S
OUTBOX_RELAY_PAGE_SIZE=100

# Energy aggregation and reconciliation (ISO-8601 durations)
AGGREGATION_CONSUMER_ENABLED=true
AGGREGATION_RECONCILE_INTERVAL=PT5M
AGGREGATION_RECONCILE_INITIAL_DELAY=PT1M
AGGREGATION_RECONCILE_LOOKBACK=PT24H

# Interpretable anomaly detection
ANOMALY_ROLLING_WINDOW_HOURS=24
ANOMALY_ROLLING_MEAN_THRESHOLD_PCT=50
ANOMALY_ZSCORE_THRESHOLD=3
ANOMALY_SAME_HOUR_LOOKBACK_DAYS=14
ANOMALY_SAME_HOUR_MIN_SAMPLES=5
ANOMALY_SAME_HOUR_THRESHOLD_PCT=60
ANOMALY_PERCENTAGE_THRESHOLD_PCT=75
ANOMALY_STARTUP_HOURS=48
ANOMALY_BASELINE_LOOKBACK_DAYS=35
ANOMALY_MIN_COMPLETENESS_PCT=50
ANOMALY_MIN_EXPECTED_KWH=0.001

# -----------------------------------------------------------------------------
# External providers
# -----------------------------------------------------------------------------
# Electricity Maps carbon intensity API (https://api.electricitymap.org/v3)
# Leave empty to fall back to the deterministic mock provider.
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymap.org/v3
ELECTRICITY_MAPS_CONNECT_TIMEOUT_MS=5000
ELECTRICITY_MAPS_READ_TIMEOUT_MS=15000
ELECTRICITY_MAPS_MIN_REQUEST_INTERVAL_MS=1000
ELECTRICITY_MAPS_FORECAST_ENABLED=true
CARBON_INTENSITY_CACHE_TTL=PT5M
AGGREGATION_RECONCILE_INTERVAL=PT5M
AGGREGATION_RECONCILE_INITIAL_DELAY=PT1M
AGGREGATION_RECONCILE_LOOKBACK=PT24H

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Frontend build-time configuration
# -----------------------------------------------------------------------------
ENERLYTICS_API_BASE_URL=http://localhost:8080/api
ENERLYTICS_APP_NAME=Enerlytics

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# -----------------------------------------------------------------------------
# Telemetry Simulator
# -----------------------------------------------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL=PT1S
SIMULATOR_ACCELERATION=1.0
SIMULATOR_SEED=
SIMULATOR_ANOMALY_PROBABILITY=0.005
SIMULATOR_METER_REFRESH_INTERVAL=PT1M
SIMULATOR_KAFKA_TOPIC=enerlytics.telemetry.meter-reading-received.v1
SIMULATOR_KAFKA_CLIENT_ID=telemetry-simulator
SIMULATOR_USE_REGISTRY=false
SIMULATOR_REGISTRY_URL=http://localhost:8080/api/v1/internal/simulation/meters
SIMULATOR_REGISTRY_API_KEY=change-me-internal-api-key-min-32-characters-long
